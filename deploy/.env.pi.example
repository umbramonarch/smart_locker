# ============================================================================
# Smart Locker — Raspberry Pi environment file
# ----------------------------------------------------------------------------
# Copy this to the PROJECT ROOT as ".env" and fill in the values below:
#     cp deploy/.env.pi.example .env
# Then generate the two keys and paste them into the key lines:
#     python -m scripts.generate_key
# Keep .env secret — it holds the encryption keys (it is already gitignored).
# ============================================================================

# --- Encryption keys (REQUIRED) — generate with: python -m scripts.generate_key
SMART_LOCKER_ENC_KEY=
SMART_LOCKER_HMAC_KEY=

# --- Database -----------------------------------------------------------------
# Keep the SQLite database on the Pi's LOCAL disk, NEVER on the locker share:
# SQLite WAL mode does not work reliably over a CIFS/SMB network mount.
SMART_LOCKER_DB_PATH=/home/locker/smart_locker/smart_locker.db

# --- NFC reader (ACR1252U) — substring matched against the reader name
SMART_LOCKER_READER_NAME=ACR1252

# --- Session / borrow limits
SMART_LOCKER_SESSION_TIMEOUT=120
SMART_LOCKER_MAX_BORROWS=5

# --- Web server — the kiosk browser connects to http://localhost:8000
SMART_LOCKER_API_HOST=0.0.0.0
SMART_LOCKER_API_PORT=8000

# --- Locker file share (CIFS — see deploy/mount/) -----------------------------
# On the Pi the share is /mnt/locker. Keep Excel and photos at that root.
# Software updates are NOT dropped here — use USB locker-updates/ (copy_update).
#
# Source device master list to IMPORT. Replace the filename if yours differs:
SMART_LOCKER_SOURCE_EXCEL_PATH=/mnt/locker/device-list.xlsx

# Exported workbook to WRITE back to the share (Devices / Transactions / Users):
SMART_LOCKER_EXCEL_PATH=/mnt/locker/smart_locker_data.xlsx

# Refresh the exported workbook on the share automatically after each source import and
# photo change. Leave at 0 — status lives on the dashboard / admin Download Excel.
# Set to 1 only if you still want smart_locker_data.xlsx written on every import.
SMART_LOCKER_EXCEL_AUTO_EXPORT=0

# Device photos folder (filename = device model, e.g. 87V.jpg). May be on the share or local.
# Leave empty to disable photo import:
SMART_LOCKER_PHOTO_INPUT_PATH=/mnt/locker/photos

# Hours between automatic source imports (startup import + admin Sync still run).
SMART_LOCKER_SOURCE_SYNC_INTERVAL_HOURS=6

# Display noun for the locker join key (kiosk + dashboard). JSON/DB stay pm_number.
SMART_LOCKER_ASSET_LABEL=PM number

# Extra Excel header aliases (comma-separated), merged with built-in English names.
# Uncomment if your catalog uses a header that is not already in the built-in list.
# SMART_LOCKER_ID_HEADERS=Inventory No
# SMART_LOCKER_LOCATION_HEADERS=Whereabouts

# Location cell when the device is in the locker (not borrowed).
SMART_LOCKER_IN_LOCKER_TOKEN=Locker

# Live dashboard URL as other PCs see this Pi, and the folder on the share where
# startup writes dashboard.url (double-click opens /dashboard).
# After update.sh, set these in the live .env (the incoming tree does not overwrite .env).
# SMART_LOCKER_PUBLIC_URL=http://192.168.1.10:8000
# SMART_LOCKER_DASHBOARD_SHARE_PATH=/mnt/locker

# Shared secret for dashboard NFC bind/unbind (header X-Smart-Locker-Admin).
# LAN browsers prompt for this on 5-tap. If unset, those POSTs return 401.
# You do not have to set it here: first-boot Setup on the kiosk REQUIRES a
# password and stores it in dashboard.secret (mode 640, service-owned — the
# app cannot write this root-owned .env on the installed appliance). A value
# set here wins over dashboard.secret.
# SMART_LOCKER_DASHBOARD_ADMIN_SECRET=

# --- Software updates (deploy/install/update.sh + the admin "Software Update" button) ---
# Only path: python -m scripts.copy_update writes gitignored locker-updates/ onto
# a USB stick; update.sh copies that into $APP_DIR/locker-updates and applies it.
# CIFS is Excel/photos only — not a software-update drop. Do not add a USB
# media-root env key.

# How many old code+DB backup pairs update.sh keeps under ./backups before
# pruning the oldest.
SMART_LOCKER_KEEP_BACKUPS=5
