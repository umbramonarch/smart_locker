# ============================================================================
# Smart Locker — Raspberry Pi environment file
# ----------------------------------------------------------------------------
# Copy this to the PROJECT ROOT as ".env" and fill in the values below:
#     cp deploy/.env.pi.example .env
# Then generate the two keys and paste them into the key lines:
#     python -m scripts.generate_key
# Keep .env secret — it holds the encryption keys (it is already gitignored).
# ============================================================================

# --- Encryption keys (REQUIRED) — generate with: python -m scripts.generate_key
SMART_LOCKER_ENC_KEY=
SMART_LOCKER_HMAC_KEY=

# --- Database -----------------------------------------------------------------
# Keep the SQLite database on the Pi's LOCAL disk, NEVER on the M: share:
# SQLite WAL mode does not work reliably over a CIFS/SMB network mount.
SMART_LOCKER_DB_PATH=/home/locker/smart_locker/smart_locker.db

# --- NFC reader (ACR1252U) — substring matched against the reader name
SMART_LOCKER_READER_NAME=ACR1252

# --- Session / borrow limits
SMART_LOCKER_SESSION_TIMEOUT=120
SMART_LOCKER_MAX_BORROWS=5

# --- Web server — the kiosk browser connects to http://localhost:8000
SMART_LOCKER_API_HOST=0.0.0.0
SMART_LOCKER_API_PORT=8000

# --- M: network share (mounted via CIFS — see deploy/mount/) ------------------
# Source device master list to IMPORT (read from M:). Replace the filename with the
# real workbook name on your share:
SMART_LOCKER_SOURCE_EXCEL_PATH=/mnt/locker/Messmittelliste.xlsx

# Exported workbook to WRITE back to M: (Devices / Transactions / Users):
SMART_LOCKER_EXCEL_PATH=/mnt/locker/smart_locker_data.xlsx

# Refresh the exported workbook on M: automatically after each source import and
# photo change (set to 1 on the Pi; leave empty to export on-demand only):
SMART_LOCKER_EXCEL_AUTO_EXPORT=1

# Device photos folder (filename = device model, e.g. 87V.jpg). May be on M: or local.
# Leave empty to disable photo import:
SMART_LOCKER_PHOTO_INPUT_PATH=/mnt/locker/photos

# --- Daily source import time (24h) — when the cron re-import runs
SMART_LOCKER_SOURCE_SYNC_HOUR=6
SMART_LOCKER_SOURCE_SYNC_MINUTE=0

# How often to check the source workbook's mtime for changes (seconds). Only
# used when SMART_LOCKER_SOURCE_EXCEL_PATH is on a network share, where file
# watchers (inotify) don't see remote writes — see GUIDE.md. Minimum 5.
SMART_LOCKER_SOURCE_POLL_SECONDS=30

# --- Software updates (deploy/install/update.sh + the admin "Update now" button) ---
# Folder on the M: share where release tarballs (smart-locker-<version>.tar.gz)
# are dropped. update.sh reads THIS .env file directly (it isn't a Python
# process), so changing this one value is enough to move where updates are
# picked up from — no script edits needed.
SMART_LOCKER_UPDATE_DIR=/mnt/locker/locker-updates

# How many old code+DB backup pairs update.sh keeps under ./backups before
# pruning the oldest.
SMART_LOCKER_KEEP_BACKUPS=5
