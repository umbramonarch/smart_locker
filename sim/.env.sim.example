# ============================================================================
# Smart Locker — Simulation env file  (sim/.env.sim.example)
# ----------------------------------------------------------------------------
# Mirrors deploy/.env.pi.example but wired for the no-hardware sim harness.
# Copy to the PROJECT ROOT as ".env":
#   cp sim/.env.sim.example .env          (Linux / QEMU guest)
#   Copy-Item sim\.env.sim.example .env   (Windows PowerShell)
#
# Then generate real keys and paste them in:
#   python -m scripts.generate_key
#
# PUBLIC REPO — no real keys here; all values are placeholders.
# ============================================================================

# --- Encryption keys (REQUIRED) — generate with: python -m scripts.generate_key
SMART_LOCKER_ENC_KEY=REPLACE_WITH_BASE64_KEY_FROM_generate_key
SMART_LOCKER_HMAC_KEY=REPLACE_WITH_BASE64_KEY_FROM_generate_key

# --- Database (always local disk — never on the Samba/CIFS share) -----------
SMART_LOCKER_DB_PATH=smart_locker.db

# --- NFC reader — fake reader replaces pcscd; no hardware needed ------------
SMART_LOCKER_FAKE_READER=1
# Hex UID of the simulated card. Must match the UID enrolled via enroll_card.
# Must be 4 or 7 bytes hex (8 or 14 hex chars); this value is the sample UID.
SMART_LOCKER_FAKE_DEFAULT_UID=AABBCCDD

# --- Sample data paths (from the sim/ tree) ---------------------------------
# Source master-list read by the import cron / sync_source script:
SMART_LOCKER_SOURCE_EXCEL_PATH=sim/data/Messmittelliste.sample.xlsx

# Exported workbook written back after import (relative path; off for native dev):
SMART_LOCKER_EXCEL_PATH=sim/data/smart_locker_data.xlsx

# Auto-export is disabled for native dev runs so the xlsx is not mutated:
SMART_LOCKER_EXCEL_AUTO_EXPORT=0

# Device photo folder (filenames must match device model, e.g. 87V.jpg):
SMART_LOCKER_PHOTO_INPUT_PATH=sim/data/photos

# --- Web server -------------------------------------------------------------
SMART_LOCKER_API_HOST=0.0.0.0
SMART_LOCKER_API_PORT=8000

# --- Session / borrow limits ------------------------------------------------
SMART_LOCKER_SESSION_TIMEOUT=120
SMART_LOCKER_MAX_BORROWS=5

# --- Daily source import schedule (06:00 default) ---------------------------
SMART_LOCKER_SOURCE_SYNC_HOUR=6
SMART_LOCKER_SOURCE_SYNC_MINUTE=0
