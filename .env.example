# Smart Locker Encryption Key (32 bytes, base64-encoded)
# Generate with: python -m scripts.generate_key
SMART_LOCKER_ENC_KEY=

# Smart Locker HMAC Key (32 bytes, base64-encoded)
# Generate with: python -m scripts.generate_key
SMART_LOCKER_HMAC_KEY=

# Database path (default: smart_locker.db in project root)
SMART_LOCKER_DB_PATH=smart_locker.db

# NFC Reader name substring filter
SMART_LOCKER_READER_NAME=ACR1252

# Session timeout in seconds (default: 120)
SMART_LOCKER_SESSION_TIMEOUT=120

# Maximum concurrent borrows per user (default: 5)
SMART_LOCKER_MAX_BORROWS=5

# Calibration alerts: flag "due soon" this many days before the Excel calibration date (0 = only today)
SMART_LOCKER_CALIBRATION_WARN_DAYS=14

# Path for the exported workbook (Devices / Transactions / Users sheets). Leave empty
# to use the default (smart_locker_data.xlsx in the project root). On the Pi, point this
# at the locker share, e.g. /mnt/locker/smart_locker_data.xlsx.
SMART_LOCKER_EXCEL_PATH=

# Auto-write the export to SMART_LOCKER_EXCEL_PATH after each source import and photo
# change. Off by default (export stays on-demand via the admin panel Download Excel).
# Set to 1 only if you still want the workbook on the locker share refreshed automatically.
SMART_LOCKER_EXCEL_AUTO_EXPORT=

# FastAPI server bind address (default: 0.0.0.0)
SMART_LOCKER_API_HOST=0.0.0.0

# FastAPI server port (default: 8000)
SMART_LOCKER_API_PORT=8000

# Source Excel — device master list on the locker share (path to .xlsx).
# On the Pi this is e.g. /mnt/locker/device-list.xlsx
# Leave empty to disable automatic import
SMART_LOCKER_SOURCE_EXCEL_PATH=

# Hours between automatic source imports (startup import + admin Sync still run).
# Default: 6. Minimum: 1.
SMART_LOCKER_SOURCE_SYNC_INTERVAL_HOURS=6

# Display noun for the locker join key (kiosk + dashboard). JSON/DB stay pm_number.
# SMART_LOCKER_ASSET_LABEL=PM number

# Extra Excel header aliases (comma-separated, case-insensitive), merged with the
# built-in English lists. Used by Sync, Register Device, and Location write-back.
# SMART_LOCKER_ID_HEADERS=Inventory No, Asset Tag
# SMART_LOCKER_LOCATION_HEADERS=Whereabouts

# Cell written into Location when the device is in the locker (not borrowed).
# SMART_LOCKER_IN_LOCKER_TOKEN=Locker

# Cell written into Location while the device is in maintenance (out for calibration).
# SMART_LOCKER_MAINTENANCE_TOKEN=Maintenance

# Live dashboard URL colleagues should open, and where to write a double-click
# Windows .url shortcut on the locker share. Both must be set; startup writes
# dashboard.url. Leave empty to skip.
# SMART_LOCKER_PUBLIC_URL=http://192.168.1.10:8000
# SMART_LOCKER_DASHBOARD_SHARE_PATH=

# Shared secret for dashboard NFC bind/unbind (header X-Smart-Locker-Admin).
# If unset, those POSTs return 401 (fail closed). Overlay 5-tap is not auth.
# SMART_LOCKER_DASHBOARD_ADMIN_SECRET=

# Last source-import snapshot (admin "Last sync" line). Leave empty to store
# last_sync.json next to the SQLite database (local disk, not the share).
SMART_LOCKER_LAST_SYNC_PATH=

# Photo input folder — drop device photos here, filename = model number
# (e.g., "87V.jpg" applies to all devices with model "87V"). Leave empty to disable.
SMART_LOCKER_PHOTO_INPUT_PATH=

# DEV ONLY — simulated NFC reader for no-hardware development on your PC.
# Never set these on the Pi: production must use the real ACR1252U reader.
# SMART_LOCKER_FAKE_READER=1
# SMART_LOCKER_FAKE_DEFAULT_UID=040000A1
